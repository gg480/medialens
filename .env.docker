# =============================================================================
# MediaLens Docker 环境变量模板
# 复制此文件为 .env 并填入真实值
# 放在 docker-compose.yml 同目录下，或通过 docker-compose env_file 引用
# =============================================================================

# TMDB API（必填）
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_LANGUAGE=zh-CN

# LLM API（可选，用于模糊匹配补充）
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# 匹配阈值
TMDB_CONFIDENCE_THRESHOLD=80
LLM_CONFIDENCE_THRESHOLD=60

# 文件管理
RENAME_DRY_RUN=true
ORGANIZE_MODE=hardlink

# 数据库路径（容器内路径，使用卷映射持久化）
DB_PATH=/app/data/medialens.db

# 默认媒体扫描目录（对应卷映射中的 /media）
DATA_DIR=/media
