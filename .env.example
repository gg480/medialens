# TMDB API (必填)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_LANGUAGE=zh-CN

# LLM API (可选，用于模糊匹配补充)
LLM_PROVIDER=openai       # openai / anthropic / ollama
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini     # 或 claude-sonnet-4-20250514 / ollama/qwen2.5
LLM_API_BASE=             # 可选，自定义 API 地址

# 匹配阈值
TMDB_CONFIDENCE_THRESHOLD=80    # TMDB 置信度阈值，低于此值调 LLM
LLM_CONFIDENCE_THRESHOLD=60     # LLM 结果置信度阈值，低于此值需用户确认

# 文件管理
RENAME_DRY_RUN=true             # 默认开启 dry-run 模式
ORGANIZE_MODE=hardlink          # copy / move / hardlink
